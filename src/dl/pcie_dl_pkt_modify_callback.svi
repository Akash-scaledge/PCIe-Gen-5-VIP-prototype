class pcie_dl_pkt_modify_callback extends uvm_callback;
  `uvm_object_utils(pcie_dl_pkt_modify_callback)
  int cnt=0;
  function new(string name = "pcie_dl_pkt_modify_callback");
    super.new(name);
  endfunction
  
  virtual function void modify_item(ref pcie_dl_seq_item item);

  endfunction
endclass
